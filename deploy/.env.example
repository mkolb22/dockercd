# Copy this file to deploy/.env only on the deployment host, then restrict it
# to the owner account (for example: chmod 600 deploy/.env). deploy/.env is
# intentionally ignored by Git and must never be committed, attached to an
# issue, or copied into an application manifest.
#
# Use a freshly rotated, minimally scoped Git credential only when dockercd
# must read private repositories. Leave this empty for public repositories.
DOCKERCD_GIT_TOKEN=

# Required for a non-loopback controller API listener. Generate a unique value
# on the deployment host; do not reuse a Git credential here.
DOCKERCD_API_TOKEN=

# The two secret files are local, host-managed Compose secrets. They must not
# be committed. The controller registry contains only SHA-256 credential
# digests and grants; the Web registry contains Argon2id verifiers and the
# corresponding scoped presentation bearers.
DOCKERCD_PRESENTATION_REGISTRY_SECRET_FILE=/absolute/path/dockercd-presentation-registry.json
DOCKERCD_WEB_USERS_SECRET_FILE=/absolute/path/dockercd-web-users.json

# Public HTTPS origin for the paired development Web presentation. The Compose
# port remains loopback-only; configure an explicit TLS reverse proxy before
# this origin is reachable over a network.
DOCKERCD_WEB_PUBLIC_ORIGIN=https://dockercd-development.example.internal

# Optional loopback host-port and local image overrides for development.
DOCKERCD_DEV_API_PORT=18080
DOCKERCD_DEV_WEB_PORT=18092
DOCKERCD_IMAGE=dockercd:latest
DOCKERCD_WEB_IMAGE=dockercd-web:latest
